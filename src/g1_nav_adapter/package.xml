<?xml version="1.0"?>
<package format="3">
  <name>g1_nav_adapter</name>
  <version>0.1.0</version>
  <description>Read-only odometry to TF adapter for G1 navigation.</description>
  <maintainer email="maintainers@example.invalid">G1 Nav maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
